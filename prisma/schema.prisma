// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ПОЛЬЗОВАТЕЛИ ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String?
  name          String?
  bio           String?
  avatarUrl     String?
  bannerUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  sentRequests     Friendship[] @relation("FriendshipRequester")
  receivedRequests Friendship[] @relation("FriendshipAddressee")

  accounts  Account[]
  sessions  Session[]
  titles    Title[]
  collections Collection[]
  comments  Comment[]

  // Поля для будущего (Yandex/VK)
  provider  String?  // "credentials" | "yandex" | "vk"
  providerId String? // ID из внешнего провайдера
  createdShows Show[]        @relation("ShowCreatedBy")
  userShows    UserShow[]
}

// Стандартные модели NextAuth — не изменять без необходимости
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== СЕРИАЛЫ ====================

model Title {
  id            Int      @id @default(autoincrement())
  name          String
  originalName  String?
  dubbing       String?
  watchSite     String?
  totalSeasons  Int      @default(1)
  totalEpisodes Int      @default(0)
  posterUrl     String?
  isCompleted   Boolean  @default(false)
  isFavorite    Boolean @default(false)
  kind          String   @default("series")
  createdAt     DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  episodes    Episode[]
  ratings     Rating[]
  collections CollectionItem[]
  comments    Comment[]
}

model Episode {
  id        Int       @id @default(autoincrement())
  showId    Int?
  season    Int
  episode   Int

  // ── Старые поля — оставляем для миграции, потом удалим ──
  titleId   Int?
  watched   Boolean   @default(false)
  stoppedAt String?
  watchedAt DateTime?

  show      Show?     @relation(fields: [showId], references: [id], onDelete: Cascade)
  title     Title?    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  progress  EpisodeProgress[]

  @@unique([showId, season, episode])
  @@index([showId])
  @@index([titleId])
}

model Rating {
  id          Int      @id @default(autoincrement())
  userShowId  Int?
  episodeId   Int?
  score       Int
  createdAt   DateTime @default(now())

  // ── Старое — для миграции ──
  titleId     Int?

  userShow UserShow? @relation(fields: [userShowId], references: [id], onDelete: Cascade)
  title    Title?   @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([userShowId])
  @@index([titleId])
}

model Collection {
  id    Int    @id @default(autoincrement())
  name  String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CollectionItem[]
}

model CollectionItem {
  id           Int        @id @default(autoincrement())
  collectionId Int

  // ── Старое — для миграции ──
  titleId      Int?
  title        Title?     @relation(fields: [titleId], references: [id], onDelete: Cascade)

  // ── Новое ──
  showId       Int?
  show         Show?      @relation(fields: [showId], references: [id], onDelete: Cascade)

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, titleId])
  @@index([showId])
}

model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId String
  addresseeId String
  status      String   @default("pending") // "pending" | "accepted"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  showId    Int?
  userId    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  // ── Старое — для миграции ──
  titleId   Int?

  show  Show? @relation(fields: [showId], references: [id], onDelete: Cascade)
  title Title? @relation(fields: [titleId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([showId])
  @@index([userId])
}

// ==================== ОБЩИЙ КАТАЛОГ ====================

model Show {
  id            Int      @id @default(autoincrement())
  name          String
  originalName  String?
  description   String?  @db.Text
  posterUrl     String?
  kind          String   @default("series") // "series" | "movie"

  // ── Расширенные поля из TMDB (для Части B) ──
  tmdbId        Int?
  year          String?
  releaseDate   DateTime?
  runtime       Int?
  budget        BigInt?
  revenue       BigInt?
  countries     String[]
  studios       String[]
  genres        String[]
  director      String?
  creators      String[]
  cast          Json?
  tmdbRating    Float?
  tmdbVotes     Int?

  // ── Кто первым добавил каноническую карточку ──
  createdById String?
  createdBy   User?   @relation("ShowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes         Episode[]
  comments         Comment[]
  userShows        UserShow[]
  collectionItems  CollectionItem[]

  @@index([name])
  @@index([tmdbId])
  @@unique([tmdbId, kind])
}

model UserShow {
  id        Int      @id @default(autoincrement())
  userId    String
  showId    Int
  kind      String   @default("series")
  totalSeasons  Int   @default(1)
  totalEpisodes Int   @default(0)
  isCompleted   Boolean @default(false)
  isFavorite    Boolean @default(false)
  status String @default("watching")

  // ── Личные поля ──
  dubbing   String?
  watchSite String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  show     Show              @relation(fields: [showId], references: [id], onDelete: Cascade)
  progress EpisodeProgress[]
  ratings  Rating[]

  @@unique([userId, showId])
  @@index([userId])
  @@index([showId])
}

model EpisodeProgress {
  id          Int      @id @default(autoincrement())
  userShowId  Int
  episodeId   Int
  watched     Boolean  @default(false)
  stoppedAt   String?
  watchedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userShow UserShow @relation(fields: [userShowId], references: [id], onDelete: Cascade)
  episode  Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userShowId, episodeId])
  @@index([userShowId])
  @@index([episodeId])
}

